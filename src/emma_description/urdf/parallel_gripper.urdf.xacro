<?xml version="1.0"?>
<!--
  myCobot parallel gripper (light), adapted from elephantrobotics/mycobot_ros
  (noetic, c0d6fbe): mycobot_description/urdf/parallel_gripper/mycobot_parallel_gripper.urdf
  and the flange mount in mycobot_280_jn/mycobot_280_jn_parallel_gripper.urdf.
  Meshes are copied into meshes/parallel_gripper/ (BSD 3-Clause, see LICENSE there).

  Changes from upstream:
  - gripper_base is the mesh frame (fingers along +z, left finger on +x). Upstream
    rotated every visual by -90 deg about x and the mount by +90 deg about x, which
    cancel; upstream collisions skipped the per-link rotation and sat 90 deg off.
  - The mimic joint is named gripper_base_to_gripper_right; upstream called the
    right-finger joint gripper_base_to_gripper_left.
  - Inertials added (estimated masses, bounding-box inertia) and the velocity limit
    set to 0.05 m/s instead of 0. Neither is measured.

  gripper_controller is the left finger's travel in metres: 0 is open (15 mm between
  the fingertips), -0.007 is closed. The right finger mirrors it. The 7 mm travel is
  upstream's value and has not been checked against the real gripper.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parallel_gripper">

  <xacro:macro name="gripper_link" params="name *inertial">
    <link name="${name}">
      <xacro:insert_block name="inertial"/>
      <visual>
        <geometry>
          <mesh filename="package://emma_description/meshes/parallel_gripper/${name}.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://emma_description/meshes/parallel_gripper/${name}.dae"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:gripper_link name="gripper_base">
    <inertial>
      <origin xyz="0 -0.0095 -0.0035" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="2.008e-05" ixy="0" ixz="0" iyy="2.942e-05" iyz="0" izz="2.697e-05"/>
    </inertial>
  </xacro:gripper_link>
  <xacro:gripper_link name="gripper_left">
    <inertial>
      <origin xyz="0.016 0.003 0.0183" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="3.418e-06" ixy="0" ixz="0" iyy="3.291e-06" iyz="0" izz="6.083e-07"/>
    </inertial>
  </xacro:gripper_link>
  <xacro:gripper_link name="gripper_right">
    <inertial>
      <origin xyz="-0.016 0.003 0.0183" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="3.418e-06" ixy="0" ixz="0" iyy="3.291e-06" iyz="0" izz="6.083e-07"/>
    </inertial>
  </xacro:gripper_link>

  <joint name="joint6_flange_to_gripper_base" type="fixed">
    <parent link="joint6_flange"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.034" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_controller" type="prismatic">
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-0.007" upper="0.0" velocity="0.05"/>
    <parent link="gripper_base"/>
    <child link="gripper_left"/>
  </joint>

  <joint name="gripper_base_to_gripper_right" type="prismatic">
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="0.0" upper="0.007" velocity="0.05"/>
    <parent link="gripper_base"/>
    <child link="gripper_right"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <!-- Tool centre point between the fingertips (they end 48.5 mm out), the frame
       emma_manipulation plans grasps for. z points out of the gripper. -->
  <link name="tcp"/>
  <joint name="gripper_base_to_tcp" type="fixed">
    <parent link="gripper_base"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
  </joint>

  <!-- Wrist RGB-D camera, standing in for an Orbbec Gemini 305 (68 g, 23 x 42 x 42 mm). The mount
       is a design choice, not a measured part: the body sits just past the +y edge of the
       gripper_base mesh, looking along the fingers (gripper +z) and tilted 15 deg toward them so
       the fingertips show at the bottom of the image, about 5 cm away (the minimum range is 4 cm).
       wrist_camera_link follows REP 103 (x forward); its origin is the front face, where the
       colour optical frame sits, so the sim camera does not render from inside the body. -->
  <xacro:if value="${'$(arg camera)' == 'gemini305'}">
    <link name="wrist_camera_link">
      <inertial>
        <origin xyz="-0.0115 0 0" rpy="0 0 0"/>
        <mass value="0.068"/>
        <inertia ixx="1.999e-05" ixy="0" ixz="0" iyy="1.299e-05" iyz="0" izz="1.299e-05"/>
      </inertial>
      <visual>
        <origin xyz="-0.0115 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.023 0.042 0.042"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="-0.0115 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.023 0.042 0.042"/>
        </geometry>
      </collision>
    </link>
    <joint name="gripper_base_to_wrist_camera" type="fixed">
      <parent link="gripper_base"/>
      <child link="wrist_camera_link"/>
      <origin xyz="0 0.037 0" rpy="0 -1.309 -1.5708"/>
    </joint>
    <!-- z forward, x right, y down in the image. -->
    <link name="wrist_camera_color_optical_frame"/>
    <joint name="wrist_camera_link_to_color_optical_frame" type="fixed">
      <parent link="wrist_camera_link"/>
      <child link="wrist_camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>
  </xacro:if>

</robot>
