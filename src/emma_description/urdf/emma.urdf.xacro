<?xml version="1.0"?>
<!-- Emma: myAGV (2023, Raspberry Pi) base with a myCobot 280 M5 arm on top. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="emma">

  <!-- Arm mount pose relative to the AGV base_link, from Elephant Robotics' product
       photo of this kit. The arm base bolts straight onto the top plate (z = 0.1322)
       with no bracket, centered on the LEGO-pitch hole pattern at the +x end. Yaw
       turns the M5 screen toward -x. The matching pattern at the -x end is centered
       at x = -0.0659. -->
  <xacro:arg name="mount_x" default="0.0981"/>
  <xacro:arg name="mount_y" default="-0.0044"/>
  <xacro:arg name="mount_z" default="0.1322"/>
  <xacro:arg name="mount_yaw" default="0.0"/>

  <!-- Which parts to load: base, arm, or both. -->
  <xacro:arg name="model" default="both"/>
  <xacro:property name="model" value="$(arg model)"/>

  <!-- End effector on the arm flange: parallel or none. Ignored without the arm. -->
  <xacro:arg name="gripper" default="parallel"/>

  <xacro:if value="${model in ['base', 'both']}">
    <xacro:include filename="$(find myagv_description)/urdf/myAGV.urdf"/>
    <!-- Upstream myAGV links have no inertial, and the submodule can't be edited, so
         the mass rides on a fixed child link. 3.6 kg is an estimate; the tensor is a
         solid box over the base mesh bounds. -->
    <link name="base_inertia">
      <inertial>
        <origin xyz="0.007 -0.0042 0.0661" rpy="0 0 0"/>
        <mass value="3.6"/>
        <inertia ixx="0.02098" ixy="0" ixz="0" iyy="0.0347" iyz="0" izz="0.04518"/>
      </inertial>
    </link>
    <joint name="base_footprint_to_base_inertia" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_inertia"/>
    </joint>
  </xacro:if>
  <xacro:if value="${model in ['arm', 'both']}">
    <xacro:include filename="$(find emma_description)/urdf/mycobot_280_m5.urdf.xacro"/>
    <xacro:if value="${'$(arg gripper)' == 'parallel'}">
      <xacro:include filename="$(find emma_description)/urdf/parallel_gripper.urdf.xacro"/>
    </xacro:if>
  </xacro:if>

  <xacro:if value="${model == 'both'}">
    <joint name="base_link_to_g_base" type="fixed">
      <parent link="base_link"/>
      <child link="g_base"/>
      <origin xyz="$(arg mount_x) $(arg mount_y) $(arg mount_z)" rpy="0 0 $(arg mount_yaw)"/>
    </joint>
  </xacro:if>

  <!-- ros2_control hardware: none (visualization only) or mujoco. The base is not
       driven yet, so only the arm and gripper are exposed. -->
  <xacro:arg name="ros2_control" default="none"/>
  <!-- MJCF scene loaded by the MuJoCo hardware plugin. -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="headless" default="false"/>

  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${'$(arg ros2_control)' == 'mujoco' and model == 'both'}">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg headless)</param>
      </hardware>
      <xacro:position_joint name="joint2_to_joint1"/>
      <xacro:position_joint name="joint3_to_joint2"/>
      <xacro:position_joint name="joint4_to_joint3"/>
      <xacro:position_joint name="joint5_to_joint4"/>
      <xacro:position_joint name="joint6_to_joint5"/>
      <xacro:position_joint name="joint6output_to_joint6"/>
      <xacro:if value="${'$(arg gripper)' == 'parallel'}">
        <xacro:position_joint name="gripper_controller"/>
        <!-- Mimic finger: an MJCF equality constraint drives it, so it is state only. -->
        <joint name="gripper_base_to_gripper_right">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>
    </ros2_control>
  </xacro:if>

</robot>
