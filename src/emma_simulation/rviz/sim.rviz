# RViz config for sim.launch.py. Same as emma_description's emma.rviz, but rooted at the
# odom frame (so the base moves on screen) with an Odometry display for the mecanum controller.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /mecanum_drive_controller/odometry
      Keep: 200
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Shaft Length: 0.05
        Shaft Radius: 0.005
        Head Length: 0.02
        Head Radius: 0.01
      Covariance:
        Value: false
  Global Options:
    Fixed Frame: odom
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.25
      Pitch: 0.5
      Yaw: 0.8
