<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>emma_manipulation</name>
  <version>0.0.0</version>
  <description>Arm motion planning for emma with roboplan in C++: IK, RRT and straight-line moves, grasp poses, and a move_arm command-line tool.</description>
  <maintainer email="5256190+bgill92@users.noreply.github.com">Bilal Gill</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>roboplan</depend>
  <depend>eigen</depend>
  <depend>tinyxml2</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Mesh packages the robot_description references; the planner loads their meshes and the
       tests expand emma's xacro at configure time, so these must be built first. -->
  <exec_depend>emma_description</exec_depend>
  <exec_depend>mycobot_description</exec_depend>
  <exec_depend>myagv_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
